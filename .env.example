# Public URL of the page (used for Open Graph links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend, for the "Start a project" and "Get my teardown" panels.
# Until both are set, the panels fall back to a prefilled WhatsApp message.
RESEND_API_KEY=
INQUIRY_FROM="Sarib Khan <hello@your-verified-domain.com>"
INQUIRY_TO=contact.saribkhan@gmail.com

# Keystatic. Leave unset locally (local mode). Set to github only to create the GitHub App once.
# NEXT_PUBLIC_KEYSTATIC_MODE=github
# Filled in by the GitHub App setup, then copied to Vercel:
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
